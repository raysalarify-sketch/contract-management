import { useState, useEffect, useRef, useCallback } from "react";

// ─── API ───
const API = "http://localhost:8000/api/v1";
async function api(endpoint, opts = {}) {
  const token = localStorage.getItem("access_token");
  const headers = { ...opts.headers };
  if (!(opts.body instanceof FormData)) headers["Content-Type"] = "application/json";
  if (token) headers["Authorization"] = `Bearer ${token}`;
  const res = await fetch(`${API}${endpoint}`, { ...opts, headers });
  if (res.status === 401) { localStorage.removeItem("access_token"); return null; }
  if (!res.ok) throw await res.json().catch(() => ({ error: "Unknown error" }));
  return res.json();
}

// ─── Theme ───
const T = {
  bg: "#f8fafc", card: "#ffffff", cardInner: "#f1f5f9", border: "#e2e8f0", borderLight: "#cbd5e1",
  text: "#0f172a", textSub: "#475569", textMuted: "#94a3b8",
  accent: "#6366f1", accentSoft: "rgba(99,102,241,0.08)", accentText: "#4f46e5",
  success: "#10b981", successSoft: "rgba(16,185,129,0.08)",
  warning: "#f59e0b", warningSoft: "rgba(245,158,11,0.08)",
  danger: "#ef4444", dangerSoft: "rgba(239,68,68,0.08)",
};
const font = "'Pretendard',-apple-system,'Segoe UI',sans-serif";

// ─── Helpers ───
const fmtMoney = n => { if (!n) return "0"; if (n >= 100000000) return `${(n/100000000).toFixed(n%100000000===0?0:1)}억`; if (n >= 10000) return `${(n/10000).toFixed(0)}만`; return n.toLocaleString(); };
const fmtMoneyFull = n => n ? n.toLocaleString()+"원" : "0원";
const fmtComma = v => {
  const n = String(v).replace(/[^0-9]/g, "");
  return n ? Number(n).toLocaleString() : "";
};
const getDDay = d => { const t=new Date(); t.setHours(0,0,0,0); const x=new Date(d); x.setHours(0,0,0,0); const diff=Math.ceil((x-t)/(86400000)); return diff===0?"D-Day":diff>0?`D-${diff}`:`D+${Math.abs(diff)}`; };
const typeLabel = t => ({전세:"전세",반전세:"반전세",월세:"월세"}[t]||t);
const typeColor = t => ({전세:T.accent,반전세:T.warning,월세:T.success}[t]||T.textMuted);

// ─── Reusable Components ───
function Card({children,style,onClick}){return<div onClick={onClick} style={{background:T.card,borderRadius:14,padding:"18px",border:`1px solid ${T.border}`,...style}}>{children}</div>}
function Badge({children,color="accent",style}){const c={accent:[T.accentSoft,T.accentText],success:[T.successSoft,"#34d399"],warning:[T.warningSoft,"#fbbf24"],danger:[T.dangerSoft,"#f87171"]}[color]||[T.accentSoft,T.accentText];return<span style={{display:"inline-flex",alignItems:"center",gap:4,fontSize:11,fontWeight:700,padding:"4px 10px",borderRadius:8,background:c[0],color:c[1],...style}}>{children}</span>}
function Btn({children,variant="primary",size="md",disabled,style,...p}){const s=variant==="primary"?{background:T.accent,color:"#fff"}:variant==="ghost"?{background:"transparent",color:T.textSub,border:`1px solid ${T.border}`}:{background:T.cardInner,color:T.text};const sz=size==="lg"?{padding:"14px 24px",fontSize:15}:{padding:"10px 18px",fontSize:13};return<button disabled={disabled} style={{borderRadius:10,border:"none",fontWeight:700,cursor:disabled?"not-allowed":"pointer",fontFamily:font,opacity:disabled?.5:1,...s,...sz,...style}} {...p}>{children}</button>}
function Input({label,suffix,...p}){return<div style={{marginBottom:0}}>{label&&<label style={{fontSize:11,color:T.textMuted,fontWeight:600,display:"block",marginBottom:4,letterSpacing:".03em"}}>{label}</label>}<div style={{position:"relative"}}><input style={{width:"100%",padding:"10px 12px",paddingRight:suffix?"40px":"12px",borderRadius:10,border:`1px solid ${T.border}`,background:T.cardInner,color:T.text,fontSize:14,outline:"none",fontFamily:font,boxSizing:"border-box"}} {...p}/>{suffix&&<span style={{position:"absolute",right:12,top:"50%",transform:"translateY(-50%)",fontSize:12,color:T.textMuted}}>{suffix}</span>}</div></div>}
function Select({label,options,...p}){return<div>{label&&<label style={{fontSize:11,color:T.textMuted,fontWeight:600,display:"block",marginBottom:4}}>{label}</label>}<select style={{width:"100%",padding:"10px 12px",borderRadius:10,border:`1px solid ${T.border}`,background:T.cardInner,color:T.text,fontSize:14,fontFamily:font}} {...p}>{options.map(o=><option key={o.value} value={o.value}>{o.label}</option>)}</select></div>}

// ─── OCR Mock (replace with real API) ───
const mockOCR = (fileName) => {
  const isValid = /계약서|임대차|전세|월세|contract/i.test(fileName||"계약서");
  if (!isValid) return null;
  return { 
    contractType: "월세", 
    deposit: 50000000, 
    monthlyRent: 800000, 
    maintenanceFee: 100000, 
    rentDay: 25, 
    startDate: "2025-03-01", 
    endDate: "2027-02-28", 
    address: "서울특별시 강남구 테헤란로 123, 워크드타워 402호", 
    tenantName: "임차인", 
    tenantPhone: "010-1234-5678", 
    landlordName: "김철수", 
    landlordPhone: "010-9876-5432", 
    landlordBank: "KB국민", 
    landlordAccount: "123-456-789012" 
  };
};

// ─── Step 0: Landing Page ───
function LandingPage({ onStart, onLogin }) {
  return (
    <div style={{
      minHeight: "calc(100vh - 64px)", display: "flex", flexDirection: "column",
      alignItems: "center", justifyContent: "center", padding: "40px 20px",
      textAlign: "center", background: T.bg
    }}>
      <div style={{ 
        width: 80, height: 80, background: T.accentSoft, borderRadius: 24, 
        display: "flex", alignItems: "center", justifyContent: "center", 
        fontSize: 40, marginBottom: 24, border: `1px solid ${T.accent}`
      }}>🏠</div>
      <h1 style={{ fontSize: 32, fontWeight: 900, color: T.text, marginBottom: 12, letterSpacing: "-0.04em" }}>
        스마트한 임대차 관리<br/>
        <span style={{ color: T.accent }}>전세케어</span>로 시작하세요
      </h1>
      <p style={{ fontSize: 16, color: T.textSub, marginBottom: 40, lineHeight: 1.6, maxWidth: 300 }}>
        계약서 사진 한 장으로 시작하는<br/>
        간편한 월세 알람 및 리마인드 서비스
      </p>
      
      <div style={{ width: "100%", maxWidth: 320, display: "flex", flexDirection: "column", gap: 12 }}>
        <Btn onClick={onStart} style={{ padding: "18px", fontSize: 16, width: "100%" }}>
          계약 등록하고 알림 받기
        </Btn>
        <Btn variant="ghost" onClick={onLogin} style={{ padding: "18px", fontSize: 16, width: "100%", background: "transparent" }}>
          이미 등록된 계약 확인하기
        </Btn>
      </div>
    </div>
  );
}

// ─── Step 0.5: Simple Login Page ───
function SimpleLoginPage({ onLoginSuccess, onBack }) {
  const [name, setName] = useState("");
  const [pin, setPin] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  const handleLogin = async () => {
    if (!name || pin.length !== 6) {
      setError("성함과 6자리 비밀번호를 정확히 입력해주세요.");
      return;
    }
    setLoading(true);
    setError("");
    try {
      const res = await api("/accounts/simple-login/", {
        method: "POST",
        body: JSON.stringify({ name, pin })
      });
      if (res?.access) {
        localStorage.setItem("access_token", res.access);
        localStorage.setItem("refresh_token", res.refresh);
        onLoginSuccess(res.user);
      } else {
        setError(res?.error || "로그인 정보를 확인해주세요.");
      }
    } catch (e) {
      setError("서버 통신 오류가 발생했습니다.");
    } finally {
      setLoading(false);
    }
  };

  return (
    <div style={{ padding: "40px 20px", display: "flex", flexDirection: "column", gap: 24, maxWidth: 400, margin: "0 auto" }}>
      <div onClick={onBack} style={{ cursor: "pointer", color: T.textMuted }}>← 돌아가기</div>
      <h2 style={{ fontSize: 24, fontWeight: 800 }}>내 계약 확인하기</h2>
      <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
        <Input label="성함" value={name} onChange={e => setName(e.target.value)} placeholder="등록하신 성함을 입력하세요" />
        <Input label="비밀번호 (6자리)" type="password" value={pin} onChange={e => setPin(e.target.value.replace(/[^0-9]/g, '').slice(0, 6))} placeholder="설정한 6자리 번호" />
        {error && <div style={{ color: T.danger, fontSize: 13 }}>{error}</div>}
        <Btn onClick={handleLogin} disabled={loading} style={{ marginTop: 8 }}>
          {loading ? "확인 중..." : "계약 확인하기"}
        </Btn>
      </div>
    </div>
  );
}

// ─── Step 1: Contract Upload ───
function ContractUploadPage({ onNext }) {
  const [step, setStep] = useState("manual"); // choose | upload | ocr | manual | edit | pin
  const [data, setData] = useState(null);
  const [uploading, setUploading] = useState(false);
  const [ocrFailed, setOcrFailed] = useState(false);
  const fileRef = useRef(null);
  const set = (k,v) => setData(d=>({...d,[k]:v}));

  const emptyContract = () => ({ 
    contractType:"월세", deposit:0, monthlyRent:0, maintenanceFee:0, rentDay:25, 
    startDate:"", endDate:"", address:"", tenantName:"", tenantPhone:"", 
    landlordName:"", landlordPhone:"", landlordBank:"", landlordAccount:"",
    pin: ""
  });

  const handleFile = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    setUploading(true);
    setTimeout(() => {
      const result = mockOCR(file.name);
      if (result) { setData(result); setStep("ocr"); }
      else { setOcrFailed(true); setData(emptyContract()); setStep("manual"); }
      setUploading(false);
    }, 2000);
  };

  const handleSave = () => {
    if (!data.tenantName || !data.tenantPhone) { 
      alert("임차인 정보를 입력해주세요."); 
      return; 
    }
    if (!data.startDate || !data.endDate || !data.address) { 
      alert("계약 정보와 주소를 입력해주세요."); 
      return; 
    }
    setStep("pin");
  };

  if (step === "choose") return (
    <Page title="계약관리" subtitle="임대차계약 관리 시작하기">
      <Card style={{padding:28,textAlign:"center",cursor:"pointer",border:`2px dashed ${T.borderLight}`}} onClick={()=>{if(fileRef.current)fileRef.current.click()}}>
        <input ref={fileRef} type="file" accept=".pdf,.jpg,.jpeg,.png" style={{display:"none"}} onChange={handleFile} />
        {uploading?(
          <div style={{display:"flex",flexDirection:"column",alignItems:"center",gap:12}}>
            <div style={{width:44,height:44,borderRadius:"50%",border:`3px solid ${T.accent}`,borderTopColor:"transparent",animation:"spin .8s linear infinite"}}/>
            <div style={{color:T.accent,fontSize:15,fontWeight:600}}>OCR 분석 중...</div>
            <div style={{color:T.textMuted,fontSize:13}}>계약서 정보를 추출하고 있습니다</div>
          </div>
        ):(
          <div style={{display:"flex",flexDirection:"column",alignItems:"center",gap:10}}>
            <div style={{fontSize:36}}>📄</div>
            <div style={{color:T.text,fontSize:16,fontWeight:700}}>임대차계약서 업로드</div>
            <div style={{color:T.textMuted,fontSize:13}}>PDF, JPG, PNG · OCR 자동 인식</div>
          </div>
        )}
      </Card>
      <div style={{textAlign:"center",padding:"12px 0",color:T.textMuted,fontSize:13}}>또는</div>
      <Btn variant="ghost" style={{width:"100%"}} onClick={()=>{setData(emptyContract());setStep("manual")}}>
        수기 입력으로 등록
      </Btn>
      
      <Card style={{marginTop:16,padding:16,background:T.accentSoft,border:`1px solid ${T.border}`}}>
        <div style={{fontSize:13,color:T.accentText,fontWeight:700,marginBottom:8}}>🔍 OCR 인식 안내</div>
        <div style={{fontSize:12,color:T.textSub,lineHeight:1.6,wordBreak:"keep-all"}}>
          • 표준 임대차계약서 양식만 인식 가능합니다.<br/>
          • 빛 반사가 없고 글자가 선명한 사진을 준비해주세요.<br/>
          • 문서의 네 모서리가 모두 보이게 촬영해주세요.<br/>
          • 수기/낙서가 많은 문서는 인식이 어려울 수 있습니다.
        </div>
      </Card>
    </Page>
  );

  if (step === "ocr") return (
    <Page title="OCR 추출 완료" subtitle="추출된 정보를 확인해주세요" onBack={()=>setStep("choose")}>
      <Badge color="success" style={{marginBottom:12}}>✓ 자동 추출 완료</Badge>
      <Card>
        <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:14}}>
          {[["계약유형",typeLabel(data.contractType)],["보증금",fmtMoneyFull(data.deposit)],["월세",data.contractType==="전세"?"없음":fmtMoneyFull(data.monthlyRent)],["납부일",data.contractType==="전세"?"-":`매월 ${data.rentDay}일`],["시작일",data.startDate],["종료일",data.endDate]].map(([l,v])=>(
            <div key={l}><div style={{fontSize:11,color:T.textMuted,marginBottom:3}}>{l}</div><div style={{fontSize:14,color:T.text,fontWeight:600}}>{v}</div></div>
          ))}
        </div>
        <div style={{marginTop:14,paddingTop:14,borderTop:`1px solid ${T.border}`}}>
          <div style={{fontSize:11,color:T.textMuted,marginBottom:3}}>물건지</div>
          <div style={{fontSize:14,color:T.text}}>{data.address}</div>
        </div>
      </Card>
      <div style={{display:"flex",gap:10,marginTop:8}}>
        <Btn variant="ghost" style={{flex:1}} onClick={()=>setStep("choose")}>다시 업로드</Btn>
        <Btn style={{flex:2}} onClick={()=>setStep("edit")}>정보 보정 및 등록 →</Btn>
      </div>
    </Page>
  );

  // manual or edit
  return (
    <Page title={step==="manual"?"수기 입력":"계약 정보 보정"} subtitle="정확한 정보를 입력해주세요" onBack={()=>setStep("choose")}>
      {ocrFailed && <Badge color="warning" style={{marginBottom:12}}>임대차계약서가 아닌 파일입니다. 수기입력으로 진행합니다.</Badge>}

      <Card>
        <SectionTitle icon="🏠" title="계약 정보" />
        <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:12}}>
          <Select label="계약유형" options={[{value:"전세",label:"전세"},{value:"반전세",label:"반전세"},{value:"월세",label:"월세"}]} value={data.contractType} onChange={e=>set("contractType",e.target.value)} />
          <Input label="보증금" value={fmtComma(data.deposit)} suffix="원" onChange={e=>set("deposit",Number(e.target.value.replace(/[^0-9]/g,"")))} />
          {data.contractType!=="전세"&&<>
            <Input label="월세" value={fmtComma(data.monthlyRent)} suffix="원" onChange={e=>set("monthlyRent",Number(e.target.value.replace(/[^0-9]/g,"")))} />
            <Input label="납부일" type="number" value={data.rentDay||""} suffix="일" onChange={e=>set("rentDay",Number(e.target.value))} />
          </>}
          <Input label="관리비" value={fmtComma(data.maintenanceFee)} suffix="원" onChange={e=>set("maintenanceFee",Number(e.target.value.replace(/[^0-9]/g,"")))} placeholder="0" />
          <div/>
          <Input label="계약시작일" type="date" value={data.startDate} onChange={e=>set("startDate",e.target.value)} />
          <Input label="계약종료일" type="date" value={data.endDate} onChange={e=>set("endDate",e.target.value)} />
        </div>
        <div style={{marginTop:12}}>
          <Input label="물건지 주소" value={data.address} onChange={e=>set("address",e.target.value)} placeholder="서울시 강남구..." />
        </div>
      </Card>

      <Card>
        <SectionTitle icon="👤" title="임차인 (본인) 정보" />
        <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:12}}>
          <Input label="성명" value={data.tenantName} onChange={e=>set("tenantName",e.target.value)} placeholder="홍길동" />
          <Input label="연락처" value={data.tenantPhone} onChange={e=>set("tenantPhone",e.target.value)} placeholder="010-0000-0000" />
        </div>
      </Card>

      <Card>
        <SectionTitle icon="🏢" title="임대인 정보" />
        <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:12}}>
          <Input label="성명" value={data.landlordName} onChange={e=>set("landlordName",e.target.value)} placeholder="임대인 이름" />
          <Input label="연락처" value={data.landlordPhone} onChange={e=>set("landlordPhone",e.target.value)} placeholder="010-0000-0000" />
        </div>
      </Card>

      <Card>
        <SectionTitle icon="💳" title="입금 계좌" />
        <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:12}}>
          <Select label="은행" options={[{value:"",label:"선택"},{value:"KB국민",label:"KB국민"},{value:"신한",label:"신한"},{value:"우리",label:"우리"},{value:"하나",label:"하나"},{value:"NH농협",label:"NH농협"},{value:"카카오뱅크",label:"카카오뱅크"},{value:"토스뱅크",label:"토스뱅크"}]} value={data.landlordBank} onChange={e=>set("landlordBank",e.target.value)} />
          <Input label="계좌번호" value={data.landlordAccount} onChange={e=>set("landlordAccount",e.target.value)} placeholder="계좌번호" />
        </div>
      </Card>

      <Btn size="lg" style={{width:"100%",marginTop:4}} onClick={handleSave}>다음 단계로 →</Btn>
    </Page>
  );

  if (step === "pin") return (
    <Page title="비밀번호 설정" subtitle="내 계약을 확인할 때 사용할 6자리 번호를 입력해주세요" onBack={()=>setStep("edit")}>
      <Card style={{padding:24}}>
        <div style={{fontSize:13,color:T.textSub,marginBottom:16,textAlign:"center"}}>
          성함: <b>{data.tenantName}</b><br/>
          이 비밀번호를 꼭 기억해주세요.
        </div>
        <Input 
          label="비밀번호 (6자리 숫자)" 
          type="password" 
          value={data.pin} 
          onChange={e => setData({...data, pin: e.target.value.replace(/[^0-9]/g, '').slice(0,6)})} 
          placeholder="숫자 6자리를 입력하세요"
          style={{textAlign:"center",fontSize:24,letterSpacing:4}}
        />
        <Btn 
          size="lg" 
          style={{width:"100%",marginTop:24}} 
          onClick={()=>onNext(data)}
          disabled={data.pin.length !== 6}
        >
          계약 등록 완료
        </Btn>
      </Card>
    </Page>
  );
}

// ─── Step 2: Phone Login (auto after contract) ───
function PhoneLoginPage({ contractData, onLoginSuccess }) {
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => { doLogin(); }, []);

  const doLogin = async () => {
    setLoading(true);
    const phone = contractData.tenantPhone.replace(/-/g,"");
    const name = contractData.tenantName;
    try {
      // Try login first
      let data = await api("/accounts/token/", { method:"POST", body:JSON.stringify({ username:phone, password:phone }) }).catch(()=>null);
      if (!data?.access) {
        // Register then login
        await api("/accounts/register/", { method:"POST", body:JSON.stringify({ username:phone, password:phone, password_confirm:phone, first_name:name.slice(1)||name, last_name:name[0]||"", phone:contractData.tenantPhone, role:"tenant" }) }).catch(()=>{});
        data = await api("/accounts/token/", { method:"POST", body:JSON.stringify({ username:phone, password:phone }) }).catch(()=>null);
      }
      if (data?.access) {
        localStorage.setItem("access_token", data.access);
        localStorage.setItem("refresh_token", data.refresh);
        // Save contract to server
        const res = await api("/contracts/register-contract/", {
          method:"POST", body:JSON.stringify({
            contract_type:contractData.contractType, deposit:contractData.deposit, monthly_rent:contractData.monthlyRent||0,
            rent_day:contractData.rentDay||25, start_date:contractData.startDate, end_date:contractData.endDate,
            address:contractData.address, landlord_name:contractData.landlordName, landlord_phone:contractData.landlordPhone,
            landlord_bank:contractData.landlordBank||"", landlord_account:contractData.landlordAccount||"",
          })
        }).catch(e=>({success:false}));
        onLoginSuccess(res?.contract_id);
      } else { setError("로그인에 실패했습니다. 관리자에게 문의하세요."); }
    } catch(e) { setError("서버 연결에 실패했습니다."); }
    setLoading(false);
  };

  return (
    <Page title="전세케어" subtitle="계약 등록 중...">
      <Card style={{textAlign:"center",padding:40}}>
        {loading ? <>
          <div style={{width:44,height:44,borderRadius:"50%",border:`3px solid ${T.accent}`,borderTopColor:"transparent",animation:"spin .8s linear infinite",margin:"0 auto 16px"}}/>
          <div style={{color:T.text,fontSize:15,fontWeight:600}}>계약 등록 및 알림 설정 중...</div>
          <div style={{color:T.textMuted,fontSize:13,marginTop:8}}>{contractData.tenantName}님 ({contractData.tenantPhone})</div>
        </> : error ? <>
          <div style={{fontSize:36,marginBottom:12}}>⚠️</div>
          <div style={{color:T.danger,fontSize:14,fontWeight:600}}>{error}</div>
          <Btn style={{marginTop:16}} onClick={doLogin}>재시도</Btn>
        </> : <>
          <div style={{fontSize:36,marginBottom:12}}>✅</div>
          <div style={{color:T.success,fontSize:15,fontWeight:600}}>등록 완료!</div>
        </>}
      </Card>
    </Page>
  );
}

// ─── Contract List (multi-property) ───
function ContractListPage({ contracts, onSelect, onAdd }) {
  return (
    <Page title="전세케어" subtitle={`${contracts.length}건의 계약을 관리하고 있습니다`}>
      {contracts.map((c,i) => {
        const daysLeft = Math.ceil((new Date(c.end_date)-new Date())/(86400000));
        return (
          <Card key={c.id||i} onClick={()=>onSelect(c)} style={{cursor:"pointer",marginBottom:10}}>
            <div style={{display:"flex",justifyContent:"space-between",alignItems:"flex-start"}}>
              <div style={{flex:1}}>
                <Badge color={c.contract_type==="전세"?"accent":c.contract_type==="반전세"?"warning":"success"} style={{marginBottom:8}}>{typeLabel(c.contract_type)}</Badge>
                <div style={{fontSize:15,fontWeight:700,color:T.text,marginTop:4}}>{c.address}</div>
                <div style={{fontSize:13,color:T.textSub,marginTop:4}}>보증금 {fmtMoney(c.deposit)} {c.monthly_rent>0?`/ 월세 ${fmtMoney(c.monthly_rent)}`:""}</div>
                <div style={{fontSize:12,color:T.textMuted,marginTop:4}}>{c.start_date} ~ {c.end_date}</div>
              </div>
              <div style={{textAlign:"right",flexShrink:0}}>
                <div style={{fontSize:20,fontWeight:800,color:daysLeft<90?T.danger:daysLeft<180?T.warning:T.accent}}>{daysLeft}</div>
                <div style={{fontSize:11,color:T.textMuted}}>일 남음</div>
              </div>
            </div>
          </Card>
        );
      })}
      <Btn variant="ghost" style={{width:"100%",marginTop:8}} onClick={onAdd}>+ 새 계약 등록</Btn>
    </Page>
  );
}

// ─── Contract Detail ───
function ContractDetailPage({ contract, onBack, onTestNotify }) {
  const [tab, setTab] = useState("dashboard");
  const [schedules, setSchedules] = useState([]);
  const [notifications, setNotifications] = useState([]);

  useEffect(() => {
    if (contract.id) {
      api(`/contracts/${contract.id}/schedules/`).then(d => { if(d) setSchedules(d); }).catch(()=>{});
      api(`/contracts/${contract.id}/notifications/`).then(d => { if(d) setNotifications(d); }).catch(()=>{});
    }
  }, [contract.id]);

  const markPaid = async (id) => {
    await api(`/contracts/schedules/${id}/mark-paid/`, {method:"POST"}).catch(()=>{});
    setSchedules(s=>s.map(x=>x.id===id?{...x,status:"paid"}:x));
  };

  const daysLeft = Math.ceil((new Date(contract.end_date)-new Date())/(86400000));
  const totalPayments = schedules.length;
  const paidCount = schedules.filter(s=>s.status==="paid").length;
  const nextDue = schedules.find(s=>s.status!=="paid");
  const hasMonthly = contract.monthly_rent > 0;

  const tabs = [{id:"dashboard",label:"대시보드"},{id:"payments",label:"납부"},{id:"alerts",label:"알림"},{id:"info",label:"계약"}];

  return (
    <div style={{fontFamily:font,background:T.bg,minHeight:"100vh",maxWidth:480,margin:"0 auto",padding:"0 16px 100px"}}>
      <style>{`@import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css'); @keyframes spin{to{transform:rotate(360deg)}} *{box-sizing:border-box;margin:0;padding:0} ::-webkit-scrollbar{width:4px} ::-webkit-scrollbar-thumb{background:${T.border};border-radius:2px}`}</style>

      {/* Header */}
      <div style={{padding:"16px 0",borderBottom:`1px solid ${T.border}`,display:"flex",justifyContent:"space-between",alignItems:"center"}}>
        <div style={{display:"flex",alignItems:"center",gap:10}}>
          <button onClick={onBack} style={{background:"none",border:"none",color:T.textMuted,fontSize:18,cursor:"pointer",padding:4}}>←</button>
          <div>
            <div style={{fontSize:10,color:T.accent,fontWeight:700,letterSpacing:".1em"}}>전세케어</div>
            <div style={{fontSize:14,fontWeight:700,color:T.text,whiteSpace:"nowrap",overflow:"hidden",textOverflow:"ellipsis",maxWidth:220}}>{contract.address?.split(",")[0]||"계약 상세"}</div>
          </div>
        </div>
        <Badge color={contract.contract_type==="전세"?"accent":contract.contract_type==="반전세"?"warning":"success"}>{typeLabel(contract.contract_type)}</Badge>
      </div>

      {/* Tabs */}
      <div style={{display:"flex",gap:4,padding:"12px 0",borderBottom:`1px solid ${T.border}`}}>
        {tabs.map(t=><button key={t.id} onClick={()=>setTab(t.id)} style={{flex:1,padding:"8px 0",borderRadius:8,border:"none",background:tab===t.id?T.accentSoft:"transparent",color:tab===t.id?T.accentText:T.textMuted,fontSize:12,fontWeight:700,cursor:"pointer",fontFamily:font}}>{t.label}</button>)}
      </div>

      <div style={{paddingTop:16,display:"flex",flexDirection:"column",gap:14}}>
        {tab==="dashboard" && <>
          {/* Summary Cards */}
          <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10}}>
            <Card style={{textAlign:"center",padding:14}}>
              <div style={{fontSize:24,fontWeight:800,color:daysLeft<90?T.danger:daysLeft<180?T.warning:T.accent}}>{daysLeft}</div>
              <div style={{fontSize:11,color:T.textMuted}}>잔여일</div>
            </Card>
            <Card style={{textAlign:"center",padding:14}}>
              <div style={{fontSize:24,fontWeight:800,color:T.text}}>{fmtMoney(contract.deposit)}</div>
              <div style={{fontSize:11,color:T.textMuted}}>보증금</div>
            </Card>
          </div>

          {/* 만료 경고 */}
          {daysLeft<=90 && <Card style={{background:T.dangerSoft,border:`1px solid rgba(239,68,68,0.3)`,padding:14}}>
            <div style={{fontSize:13,fontWeight:700,color:"#f87171"}}>🚨 계약 만료 {daysLeft}일 전</div>
            <div style={{fontSize:12,color:"#fca5a5",marginTop:4}}>갱신/종료 여부를 임대인과 협의하세요</div>
          </Card>}

          {/* 월세 납부 현황 (월세/반전세만) */}
          {hasMonthly && <>
            <Card>
              <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:10}}>
                <div style={{fontSize:14,fontWeight:700,color:T.text}}>납부 현황</div>
                <div style={{fontSize:12,color:T.textSub}}>{paidCount}/{totalPayments}회</div>
              </div>
              <div style={{height:6,borderRadius:3,background:T.cardInner,overflow:"hidden"}}>
                <div style={{height:"100%",borderRadius:3,background:T.accent,width:`${totalPayments?paidCount/totalPayments*100:0}%`,transition:"width .3s"}}/>
              </div>
            </Card>
            {nextDue && <Card>
              <div style={{fontSize:11,color:T.textMuted,marginBottom:6}}>다음 납부</div>
              <div style={{display:"flex",justifyContent:"space-between",alignItems:"center"}}>
                <div>
                  <div style={{fontSize:16,fontWeight:700,color:T.text}}>{fmtMoneyFull(nextDue.amount)}</div>
                  <div style={{fontSize:12,color:T.textSub,marginTop:2}}>{nextDue.due_date}</div>
                </div>
                <Badge color={getDDay(nextDue.due_date)==="D-Day"?"danger":"accent"}>{getDDay(nextDue.due_date)}</Badge>
              </div>
            </Card>}
          </>}

          {/* 임대인 정보 */}
          <Card>
            <SectionTitle icon="🏢" title="임대인" />
            <div style={{fontSize:14,color:T.text,fontWeight:600}}>{contract.landlord_name||"-"}</div>
            <div style={{fontSize:13,color:T.textSub,marginTop:2}}>{contract.landlord_phone||"-"}</div>
            {contract.landlord_bank && <div style={{fontSize:12,color:T.textMuted,marginTop:4}}>💳 {contract.landlord_bank} {contract.landlord_account}</div>}
          </Card>
        </>}

        {tab==="payments" && <>
          {!hasMonthly ? (
            <Card style={{textAlign:"center",padding:32}}>
              <div style={{fontSize:36,marginBottom:8}}>🏠</div>
              <div style={{fontSize:15,fontWeight:700,color:T.text}}>전세 계약</div>
              <div style={{fontSize:13,color:T.textSub,marginTop:6}}>월세 납부가 없는 전세 계약입니다.<br/>계약 만료일 알림을 자동으로 받으실 수 있습니다.</div>
            </Card>
          ) : (
            <>
              <div style={{display:"flex",gap:8}}>
                <Badge color="success">{paidCount}건 납부</Badge>
                <Badge color="danger">{totalPayments-paidCount}건 미납</Badge>
              </div>
              {schedules.map(s => {
                const isPaid = s.status==="paid";
                const dd = getDDay(s.due_date);
                return (
                  <Card key={s.id} style={{padding:14}}>
                    <div style={{display:"flex",justifyContent:"space-between",alignItems:"center"}}>
                      <div style={{flex:1}}>
                        <div style={{display:"flex",alignItems:"center",gap:8}}>
                          <span style={{fontSize:14,fontWeight:600,color:T.text}}>{s.due_date}</span>
                          <Badge color={isPaid?"success":dd==="D-Day"?"danger":"accent"}>{isPaid?"납부완료":dd}</Badge>
                        </div>
                        <div style={{fontSize:13,color:T.textSub,marginTop:4}}>{fmtMoneyFull(s.amount)}</div>
                      </div>
                      {!isPaid && <Btn size="sm" onClick={()=>markPaid(s.id)} style={{padding:"6px 14px",fontSize:12}}>납부확인</Btn>}
                    </div>
                  </Card>
                );
              })}
            </>
          )}
        </>}

        {tab==="alerts" && <>
          <div style={{display:"flex",justifyContent:"space-between",alignItems:"center"}}>
            <div style={{fontSize:14,fontWeight:700,color:T.text}}>발송 이력</div>
            <Btn variant="ghost" onClick={()=>onTestNotify(contract)} style={{padding:"6px 14px",fontSize:12}}>테스트 발송</Btn>
          </div>
          {notifications.length===0 ? (
            <Card style={{textAlign:"center",padding:28}}>
              <div style={{fontSize:32,marginBottom:8}}>📭</div>
              <div style={{color:T.textMuted,fontSize:13}}>아직 발송 이력이 없습니다</div>
            </Card>
          ) : notifications.map((n,i)=>(
            <Card key={n.id||i} style={{padding:14}}>
              <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:6}}>
                <div style={{display:"flex",gap:6}}>
                  <Badge color={n.channel==="kakao"?"warning":"accent"} style={{fontSize:10}}>{n.channel==="kakao"?"알림톡":"SMS"}</Badge>
                  <Badge color={n.status==="sent"?"success":"danger"} style={{fontSize:10}}>{n.status==="sent"?"발송완료":"실패"}</Badge>
                </div>
                <span style={{fontSize:11,color:T.textMuted}}>{n.sent_at?new Date(n.sent_at).toLocaleString("ko"):"-"}</span>
              </div>
              <div style={{fontSize:12,color:T.textSub,whiteSpace:"pre-line",lineHeight:1.5}}>{n.content?.slice(0,120)}{n.content?.length>120?"...":""}</div>
            </Card>
          ))}

          <Card>
            <div style={{fontSize:13,fontWeight:700,color:T.text,marginBottom:10}}>알림 규칙</div>
            {[
              hasMonthly&&{icon:"📅",label:"월세 납부 D-3",desc:"3일 전 사전 안내"},
              hasMonthly&&{icon:"🔔",label:"월세 납부 당일",desc:"당일 납부 안내 + 계좌 정보"},
              hasMonthly&&{icon:"⚠️",label:"미납 알림",desc:"납부일 3일 경과 시"},
              {icon:"📋",label:"만료 3개월 전",desc:"갱신/종료 결정 안내"},
              {icon:"🚨",label:"만료 1개월 전",desc:"보증금 반환 확인 안내"},
            ].filter(Boolean).map((r,i)=>(
              <div key={i} style={{display:"flex",gap:10,alignItems:"center",padding:"8px 0",borderTop:i?`1px solid ${T.border}`:"none"}}>
                <span style={{fontSize:16}}>{r.icon}</span>
                <div><div style={{fontSize:13,color:T.text,fontWeight:600}}>{r.label}</div><div style={{fontSize:11,color:T.textMuted}}>{r.desc}</div></div>
                <div style={{marginLeft:"auto",width:8,height:8,borderRadius:"50%",background:T.success}}/>
              </div>
            ))}
          </Card>
        </>}

        {tab==="info" && <>
          <Card>
            <SectionTitle icon="📋" title="계약 정보" />
            {[["계약유형",typeLabel(contract.contract_type)],["보증금",fmtMoneyFull(contract.deposit)],["월세",contract.monthly_rent?fmtMoneyFull(contract.monthly_rent):"없음"],["계약기간",`${contract.start_date} ~ ${contract.end_date}`],["물건지",contract.address],["임대인",`${contract.landlord_name||"-"} (${contract.landlord_phone||"-"})`]].map(([l,v],i)=>(
              <div key={l} style={{display:"flex",justifyContent:"space-between",padding:"10px 0",borderTop:i?`1px solid ${T.border}`:"none"}}>
                <span style={{fontSize:13,color:T.textMuted}}>{l}</span>
                <span style={{fontSize:13,color:T.text,fontWeight:600,textAlign:"right",maxWidth:"60%"}}>{v}</span>
              </div>
            ))}
          </Card>
        </>}
      </div>
    </div>
  );
}

// ─── Layout helpers ───
function Page({title,subtitle,onBack,children}){
  return(
    <div style={{fontFamily:font,background:T.bg,minHeight:"100vh",maxWidth:480,margin:"0 auto",padding:"0 16px 40px"}}>
      <style>{`@import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css'); @keyframes spin{to{transform:rotate(360deg)}} *{box-sizing:border-box;margin:0;padding:0}`}</style>
      <div style={{padding:"20px 0 16px",borderBottom:`1px solid ${T.border}`,marginBottom:16,display:"flex",alignItems:"center",gap:10}}>
        {onBack&&<button onClick={onBack} style={{background:"none",border:"none",color:T.textMuted,fontSize:18,cursor:"pointer",padding:4}}>←</button>}
        <div>
          <div style={{fontSize:10,color:T.accent,fontWeight:700,letterSpacing:".1em"}}>전세케어</div>
          <div style={{fontSize:18,fontWeight:800,color:T.text,letterSpacing:"-.02em"}}>{title}</div>
          {subtitle&&<div style={{fontSize:13,color:T.textSub,marginTop:4}}>{subtitle}</div>}
        </div>
      </div>
      <div style={{display:"flex",flexDirection:"column",gap:14}}>{children}</div>
    </div>
  );
}
function SectionTitle({icon,title}){return<div style={{fontSize:14,fontWeight:700,color:T.text,marginBottom:12,display:"flex",alignItems:"center",gap:6}}><span style={{fontSize:16}}>{icon}</span>{title}</div>}
function ProfileModal({ user, onClose, onUpdate }) {
  const [phone, setPhone] = useState(user?.phone || "");
  const [loading, setLoading] = useState(false);
  
  const handleDevLogin = async () => {
    // Quickly get a fresh token for dev testing if expired
    const testUsername = "01012345678";
    try {
      const res = await api("/accounts/token/", { method:"POST", body:JSON.stringify({ username:testUsername, password:testUsername }) });
      if(res?.access) {
        localStorage.setItem("access_token", res.access);
        alert("테스트 계정으로 재인증되었습니다. 새로고침을 진행합니다.");
        window.location.reload();
      }
    } catch(e) { alert("인증 갱신 실패"); }
  };

  return (
    <div style={{ position: "fixed", inset: 0, background: "rgba(0,0,0,0.8)", backdropFilter: "blur(4px)", zIndex: 1000, display: "flex", alignItems: "center", justifyContent: "center", padding: 20 }}>
      <Card style={{ width: "100%", maxWidth: 360, position: "relative" }}>
        <button onClick={onClose} style={{ position: "absolute", top: 12, right: 12, background: "none", border: "none", color: T.textMuted, fontSize: 20, cursor: "pointer" }}>×</button>
        <SectionTitle icon="👤" title="내 정보 관리" />
        <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
          <Input label="성함" value={user?.username || ""} disabled />
          <Input label="연락처" value={phone} onChange={e => setPhone(e.target.value)} placeholder="010-0000-0000" />
          <Btn onClick={async () => {
            setLoading(true);
            const res = await onUpdate(phone);
            setLoading(false);
            if (res) onClose();
          }} disabled={loading} style={{ width: "100%", marginTop: 8 }}>
            {loading ? "저장 중..." : "변경사항 저장"}
          </Btn>
          <div style={{ borderTop: `1px solid ${T.border}`, marginTop: 12, paddingTop: 12 }}>
             <button onClick={handleDevLogin} style={{ background: "none", border: "none", color: T.accent, fontSize: 11, cursor: "pointer", textDecoration: "underline" }}>
               인증 만료 시 테스트 계정으로 재인증(Dev)
             </button>
          </div>
        </div>
      </Card>
    </div>
  );
}

// ─── Main App ───
export default function App() {
  const [page, setPage] = useState("loading"); // loading | upload | login | list | detail
  const [user, setUser] = useState(null);
  const [contracts, setContracts] = useState([]);
  const [selectedContract, setSelectedContract] = useState(null);
  const [pendingContract, setPendingContract] = useState(null);
  const [showProfile, setShowProfile] = useState(false);

  useEffect(() => {
    const token = localStorage.getItem("access_token");
    if (token) {
      loadProfile().then(() => {
        loadContracts().then(list => {
          setPage(list.length > 0 ? "list" : "upload");
        }).catch(() => setPage("landing"));
      }).catch(() => setPage("landing"));
    } else {
      setPage("landing");
    }
  }, []);

  const loadProfile = async () => {
    const data = await api("/accounts/profile/");
    if (data) setUser(data);
    return data;
  };

  const loadContracts = async () => {
    const data = await api("/contracts/my-contracts/");
    if (data && data.length > 0) { setContracts(data); return data; }
    return [];
  };

  const handleContractUpload = (data) => {
    setPendingContract(data);
    const token = localStorage.getItem("access_token");
    if (token) {
      saveContract(data);
    } else {
      // Anonymous registration now handled by saveContract itself in backend
      saveContract(data);
    }
  };

  const saveContract = async (data) => {
    try {
      const res = await api("/contracts/register-contract/", {
        method: "POST",
        body: JSON.stringify({
          contract_type: data.contractType,
          deposit: data.deposit,
          monthly_rent: data.monthlyRent || 0,
          rent_day: data.rentDay || 25,
          start_date: data.startDate,
          end_date: data.endDate,
          address: data.address,
          landlord_name: data.landlordName,
          landlord_phone: data.landlordPhone,
          landlord_bank: data.landlordBank || "",
          landlord_account: data.landlordAccount || "",
          // Anonymous Registration Fields
          tenant_name: user?.first_name || data.tenantName || "임차인",
          tenant_phone: user?.phone || data.tenantPhone || "010-0000-0000",
          pin: data.pin
        })
      });

      if (res?.success) {
        if (res.token) {
          localStorage.setItem("access_token", res.token.access);
          localStorage.setItem("refresh_token", res.token.refresh);
          await loadProfile();
        }
        await loadContracts();
        setPage("list");
      } else {
        alert("계약 등록 실패: " + (res?.error || "알 수 없는 오류"));
      }
    } catch (e) {
      console.error(e);
      alert("서버 통신 오류가 발생했습니다.");
    }
  };

  const handleLoginSuccess = async () => {
    await loadProfile();
    if (pendingContract) await saveContract(pendingContract);
    else {
      const list = await loadContracts();
      setPage(list.length > 0 ? "list" : "upload");
    }
  };

  const handleUpdateProfile = async (phone) => {
    try {
      const res = await api("/contracts/accounts/profile/update/", {
        method: "POST",
        body: JSON.stringify({ phone }),
      });
      if (res?.success) {
        alert("프로필이 업데이트되었습니다.");
        await loadProfile();
        return true;
      } else {
        alert(`저장 실패: ${res?.error || "알 수 없는 오류"}\n${res?.detail || ""}`);
        return false;
      }
    } catch (e) {
      alert(`저장 오류: ${e.error || e.message}`);
      return false;
    }
  };

  const handleLogout = () => {
    localStorage.removeItem("access_token");
    localStorage.removeItem("refresh_token");
    setUser(null);
    setContracts([]);
    setPage("upload");
  };

  const handleTestNotify = async (contract) => {
    try {
      const res = await api("/contracts/test-notification/", {
        method: "POST", body: JSON.stringify({
          template: "PAYMENT_D3",
          variables: {
            tenant_name: user?.username || user?.first_name || "임차인",
            payment_type: "월세",
            address: contract.address || "",
            due_date: new Date().toISOString().split('T')[0],
            amount: fmtMoney(contract.monthly_rent || 0),
            bank: contract.landlord_bank || "-",
            account: contract.landlord_account || "-",
            landlord_name: contract.landlord_name || "임대인",
          }
        })
      });
      if (res?.success && res?.status !== "failed") {
        alert("알림톡 + SMS 발송 완료!");
      } else {
        alert(`발송 결과: ${res?.status}\n내용: ${JSON.stringify(res?.raw_result || res, null, 2)}`);
      }
    } catch (e) { alert("발송 오류: " + JSON.stringify(e)); }
  };

  if (page === "loading") return (
    <div style={{fontFamily:font,background:T.bg,minHeight:"100vh",display:"flex",alignItems:"center",justifyContent:"center"}}>
      <style>{`@import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css'); *{box-sizing:border-box;margin:0;padding:0}`}</style>
      <div style={{textAlign:"center"}}>
        <div style={{fontSize:10,color:T.accent,fontWeight:700,letterSpacing:".1em"}}>계약관리</div>
        <div style={{fontSize:14,color:T.textMuted,marginTop:8}}>로딩 중...</div>
      </div>
    </div>
  );

  return (
    <div style={{ fontFamily: font, background: T.bg, minHeight: "100vh", position: "relative", boxSizing: "border-box" }}>
      <style>{`
        @import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css');
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background: ${T.bg}; color: ${T.text}; }
        /* Hide scrollbar for Chrome, Safari and Opera */
        ::-webkit-scrollbar { display: none; }
        * { -ms-overflow-style: none; scrollbar-width: none; }
      `}</style>

      {/* ─── Global Header ─── */}
      <header style={{
        position: "fixed", top: 0, left: 0, right: 0, height: "64px",
        background: "rgba(30, 32, 44, 0.8)", backdropFilter: "blur(12px)",
        borderBottom: `1px solid ${T.border}`,
        display: "flex", alignItems: "center", justifyContent: "space-between",
        padding: "0 20px", zIndex: 1000
      }}>
        <div style={{ display: "flex", alignItems: "center", gap: 10, cursor: "pointer" }} onClick={() => setPage(user ? "list" : "landing")}>
          <span style={{ fontSize: 24 }}>🏠</span>
          <span style={{ fontSize: 18, fontWeight: 800, color: T.accent, letterSpacing: "-0.02em" }}>계약관리</span>
        </div>

        {user && (
          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
            <button 
              onClick={() => setPage("list")} 
              style={{ background: "transparent", border: "none", fontSize: 18, cursor: "pointer", width: 40, height: 40, display: "flex", alignItems: "center", justifyContent: "center" }}
            >
              🏠
            </button>
            <button 
              onClick={() => setShowProfile(true)} 
              style={{ background: T.card, border: `1px solid ${T.border}`, borderRadius: "50%", width: 36, height: 36, display: "flex", alignItems: "center", justifyContent: "center", cursor: "pointer", fontSize: 18 }}
            >
              👤
            </button>
            <button 
              onClick={handleLogout} 
              style={{ background: "transparent", border: "none", fontSize: 18, cursor: "pointer", width: 40, height: 40, display: "flex", alignItems: "center", justifyContent: "center" }}
            >
              🚪
            </button>
          </div>
        )}
      </header>

      {/* ─── Main Content ─── */}
      <div style={{ paddingTop: "84px", paddingBottom: "40px" }}>
        {showProfile && <ProfileModal user={user} onClose={() => setShowProfile(false)} onUpdate={handleUpdateProfile} />}
        {page === "landing" && (
          <LandingPage 
            onStart={() => setPage("upload")} 
            onLogin={() => setPage("login")} 
          />
        )}
        {page === "login" && (
          <SimpleLoginPage 
            onLoginSuccess={(u) => { setUser(u); loadContracts().then(() => setPage("list")); }} 
            onBack={() => setPage("landing")} 
          />
        )}
        {page === "upload" && <ContractUploadPage onNext={handleContractUpload} />}
        {page === "detail" && selectedContract && (
          <ContractDetailPage
            contract={selectedContract}
            onBack={() => { setSelectedContract(null); loadContracts(); setPage("list"); }}
            onTestNotify={handleTestNotify}
          />
        )}
        {page === "list" && (
          <ContractListPage
            contracts={contracts}
            onSelect={(c) => { setSelectedContract(c); setPage("detail"); }}
            onAdd={() => setPage("upload")}
          />
        )}
      </div>
    </div>
  );
}
